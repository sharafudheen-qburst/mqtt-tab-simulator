<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
    <add key="IRHTechnology" value="https://pkgs.dev.azure.com/IRHTechnology/Digimine/_packaging/irh-nuget-lib-repo/nuget/v3/index.json"/>
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*"/>
    </packageSource>
    <packageSource key="IRHTechnology">
      <package pattern="Bedrock.*"/>
      <package pattern="BGT.*"/>
    </packageSource>
  </packageSourceMapping>
</configuration>